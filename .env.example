# Supabase — see supabase/migrations/ for schema and scripts/seed-*.ts for
# seed data. Never commit real values to this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, used only by `npm run seed:admin`. If unset, a random password is
# generated and printed once when the admin account is created.
SEED_ADMIN_PASSWORD=

# The public address of the site, without a trailing slash, e.g.
# https://www.ethiomart.com — used for canonical URLs, the sitemap, robots.txt,
# Open Graph links and structured data. Set it for every real deployment; when
# unset, links fall back to http://localhost:3000 (and a warning is printed
# during `next build`).
NEXT_PUBLIC_SITE_URL=

# Email through Resend (README "Going live → 5. Email"). Server-only: NEVER
# prefix with NEXT_PUBLIC_. Leave empty to run without email (emails stay
# queued). The key starts with re_ (Resend → API Keys, "Sending access").
RESEND_API_KEY=
# The sender, an address on your Resend-verified domain:
# Evael Store <orders@your-shop.com>
EMAIL_FROM=
# Where new-order alerts and contact-form messages go.
SHOP_NOTIFY_EMAIL=
# 32+ random characters; the database needs the same value
# (select public.set_email_dispatch_secret('...'); in the SQL editor).
EMAIL_DISPATCH_SECRET=
